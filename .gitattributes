                        <strong class="text-indigo-900 block font-semibold">Best Architectural Use Case:</strong>
                        <p class="text-indigo-800">${tool.bestFor}</p>
                    </div>
                </div>
            `;

            document.getElementById('tool-modal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('tool-modal').classList.add('hidden');
        }

        // Helper to compute overall total active users for metric card
        function updateTotalUsersMetric() {
            const lastIdx = globalUserTelemetry.labels.length - 1;
            const sumK = globalUserTelemetry.layers.l1[lastIdx] +
                         globalUserTelemetry.layers.l2[lastIdx] +
                         globalUserTelemetry.layers.l3[lastIdx] +
                         globalUserTelemetry.layers.l4[lastIdx] +
                         globalUserTelemetry.layers.l5[lastIdx];
            
            const millions = (sumK / 1000).toFixed(2);
            document.getElementById('stat-total-users').innerText = `${millions}M+`;
        }

        // Live Telemetry Refresh Feature
        function refreshUserTelemetry() {
            const lastIdx = globalUserTelemetry.labels.length - 1;
            
            // Simulate live user count updates with realistic small jitter/increment
            globalUserTelemetry.layers.l1[lastIdx] += Math.floor(Math.random() * 18) + 2;
            globalUserTelemetry.layers.l2[lastIdx] += Math.floor(Math.random() * 15) + 3;
            globalUserTelemetry.layers.l3[lastIdx] += Math.floor(Math.random() * 8) + 1;
            globalUserTelemetry.layers.l4[lastIdx] += Math.floor(Math.random() * 10) + 1;
            globalUserTelemetry.layers.l5[lastIdx] += Math.floor(Math.random() * 12) + 2;

            if (userStatsChartInstance) {
                userStatsChartInstance.data.datasets[0].data = [...globalUserTelemetry.layers.l1];
                userStatsChartInstance.data.datasets[1].data = [...globalUserTelemetry.layers.l2];
                userStatsChartInstance.data.datasets[2].data = [...globalUserTelemetry.layers.l3];
                userStatsChartInstance.data.datasets[3].data = [...globalUserTelemetry.layers.l4];
                userStatsChartInstance.data.datasets[4].data = [...globalUserTelemetry.layers.l5];
                userStatsChartInstance.update();
            }

            // Update timestamp tag
            const now = new Date();
            const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            document.getElementById('last-update-tag').innerText = `Updated: ${timeStr}`;

            // Update top metric card
            updateTotalUsersMetric();
        }

        function toggleAutoRefresh() {
            const isChecked = document.getElementById('auto-refresh-toggle').checked;
            const statusEl = document.getElementById('telemetry-status');

            if (isChecked) {
                statusEl.innerText = 'Live Auto-Polling';
                statusEl.classList.add('text-emerald-600');
                refreshUserTelemetry();
                autoRefreshTimer = setInterval(() => {
                    refreshUserTelemetry();
                }, 5000);
            } else {
                statusEl.innerText = 'Telemetry Active';
                statusEl.classList.remove('text-emerald-600');
                if (autoRefreshTimer) {
                    clearInterval(autoRefreshTimer);
                    autoRefreshTimer = null;
                }
            }
        }

        // Charts Initialization
        function initCharts() {
            // REPLACED CHART 1: Line Chart for Global Active User Statistics across Layers
            const statsCtx = document.getElementById('userStatsChart').getContext('2d');

            userStatsChartInstance = new Chart(statsCtx, {
                type: 'line',
                data: {
                    labels: globalUserTelemetry.labels,
                    datasets: [
                        {
                            label: 'L1: Instant Web Builders',
                            data: [...globalUserTelemetry.layers.l1],
                            borderColor: '#f59e0b',
                            backgroundColor: 'rgba(245, 158, 11, 0.1)',
                            borderWidth: 2,
                            tension: 0.3,
                            fill: false,
                            pointRadius: 3
                        },
                        {
                            label: 'L2: AI-Native IDEs',
                            data: [...globalUserTelemetry.layers.l2],
                            borderColor: '#6366f1',
                            backgroundColor: 'rgba(99, 102, 241, 0.1)',
                            borderWidth: 2,
                            tension: 0.3,
                            fill: false,
                            pointRadius: 3
                        },
                        {
                            label: 'L3: CLI Shell Agents',
                            data: [...globalUserTelemetry.layers.l3],
                            borderColor: '#10b981',
                            backgroundColor: 'rgba(16, 185, 129, 0.1)',
                            borderWidth: 2,
                            tension: 0.3,
                            fill: false,
                            pointRadius: 3
                        },
                        {
                            label: 'L4: Open Extensions',
                            data: [...globalUserTelemetry.layers.l4],
                            borderColor: '#06b6d4',
                            backgroundColor: 'rgba(6, 182, 212, 0.1)',
                            borderWidth: 2,
                            tension: 0.3,
                            fill: false,
                            pointRadius: 3
                        },
                        {
                            label: 'L5: Headless PR Agents',
                            data: [...globalUserTelemetry.layers.l5],
                            borderColor: '#a855f7',
                            backgroundColor: 'rgba(168, 85, 247, 0.1)',
                            borderWidth: 2,
                            tension: 0.3,
                            fill: false,
                            pointRadius: 3
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { boxWidth: 10, font: { size: 10 } }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return `${context.dataset.label}: ${context.raw.toLocaleString()}k active users`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { font: { size: 10 } }
                        },
                        y: {
                            title: { display: true, text: 'Active Developers (Thousands)', font: { size: 10 } },
                            ticks: { font: { size: 10 } },
                            beginAtZero: true
                        }
                    }
                }
            });

            // Chart 2: Layer Donut Chart
            const donutCtx = document.getElementById('layerDonutChart').getContext('2d');
            const layerCounts = [1, 2, 3, 4, 5].map(l => taxonomyData.filter(t => t.layer === l).length);

            donutChartInstance = new Chart(donutCtx, {
                type: 'doughnut',
                data: {
                    labels: [
                        'Layer 1: Instant Builders',
                        'Layer 2: AI-Native IDEs',
                        'Layer 3: CLI Shell Agents',
                        'Layer 4: Open Extensions',
                        'Layer 5: Headless PR Agents'
                    ],
                    datasets: [{
                        data: layerCounts,
                        backgroundColor: ['#f59e0b', '#6366f1', '#10b981', '#06b6d4', '#a855f7'],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { boxWidth: 12, font: { size: 10 } }
                        }
                    }
                }
            });
        }

        // Comparison Matrix Setup
        function initComparisonSelectors() {
            const container = document.getElementById('comparison-selectors');
            container.innerHTML = '';

            const createSelect = (id, defaultVal, colorClass) => {
                const select = document.createElement('select');
                select.className = `text-xs border border-stone-300 rounded-lg px-2 py-1 bg-white focus:outline-none ${colorClass}`;
                select.id = id;
                select.onchange = () => {
                    if (id === 'select-tool-1') compTool1 = select.value;
                    if (id === 'select-tool-2') compTool2 = select.value;
                    if (id === 'select-tool-3') compTool3 = select.value;
                    renderComparisonMatrix();
                };

                taxonomyData.forEach(t => {
                    const opt = document.createElement('option');
                    opt.value = t.id;
                    opt.textContent = t.name;
                    if (t.id === defaultVal) opt.selected = true;
                    select.appendChild(opt);
                });
                return select;
            };

            container.appendChild(createSelect('select-tool-1', compTool1, 'text-indigo-700 font-semibold'));
            container.appendChild(createSelect('select-tool-2', compTool2, 'text-purple-700 font-semibold'));
            container.appendChild(createSelect('select-tool-3', compTool3, 'text-emerald-700 font-semibold'));
        }

        function renderComparisonMatrix() {
            const t1 = taxonomyData.find(t => t.id === compTool1);
            const t2 = taxonomyData.find(t => t.id === compTool2);
            const t3 = taxonomyData.find(t => t.id === compTool3);

            document.getElementById('matrix-head-1').textContent = t1.name;
            document.getElementById('matrix-head-2').textContent = t2.name;
            document.getElementById('matrix-head-3').textContent = t3.name;

            const tbody = document.getElementById('comparison-matrix-body');
            tbody.innerHTML = `
                <tr>
                    <td class="p-3 font-semibold bg-stone-50">Taxonomy Layer</td>
                    <td class="p-3">${t1.layerName}</td>
                    <td class="p-3">${t2.layerName}</td>
                    <td class="p-3">${t3.layerName}</td>
                </tr>
                <tr>
                    <td class="p-3 font-semibold bg-stone-50">Execution Tier</td>
                    <td class="p-3">${t1.tier}</td>
                    <td class="p-3">${t2.tier}</td>
                    <td class="p-3">${t3.tier}</td>
                </tr>
                <tr>
                    <td class="p-3 font-semibold bg-stone-50">Runtime Environment</td>
                    <td class="p-3">${t1.runtime}</td>
                    <td class="p-3">${t2.runtime}</td>
                    <td class="p-3">${t3.runtime}</td>
                </tr>
                <tr>
                    <td class="p-3 font-semibold bg-stone-50">Skill Entry Level</td>
                    <td class="p-3"><span class="px-2 py-0.5 rounded bg-stone-100 text-slate-800">${t1.skillLevel}</span></td>
                    <td class="p-3"><span class="px-2 py-0.5 rounded bg-stone-100 text-slate-800">${t2.skillLevel}</span></td>
                    <td class="p-3"><span class="px-2 py-0.5 rounded bg-stone-100 text-slate-800">${t3.skillLevel}</span></td>
                </tr>
                <tr>
                    <td class="p-3 font-semibold bg-stone-50">Core AI Models</td>
                    <td class="p-3">${t1.models}</td>
                    <td class="p-3">${t2.models}</td>
                    <td class="p-3">${t3.models}</td>
                </tr>
                <tr>
                    <td class="p-3 font-semibold bg-stone-50">Key Architectural Strength</td>
                    <td class="p-3">${t1.bestFor}</td>
                    <td class="p-3">${t2.bestFor}</td>
                    <td class="p-3">${t3.bestFor}</td>
                </tr>
            `;
        }

        // Decision Tree Wizard Logic
        function setWizardAnswer(question, answer) {
            wizardAnswers[question] = answer;

            // Highlight buttons
            if (question === 'setup') {
                document.getElementById('wiz-setup-no').classList.toggle('bg-white/20', answer === 'no');
                document.getElementById('wiz-setup-yes').classList.toggle('bg-white/20', answer === 'yes');
            }
            if (question === 'interface') {
                document.getElementById('wiz-ui-visual').classList.toggle('bg-white/20', answer === 'visual');
                document.getElementById('wiz-ui-ide').classList.toggle('bg-white/20', answer === 'ide');
                document.getElementById('wiz-ui-cli').classList.toggle('bg-white/20', answer === 'cli');
            }
            if (question === 'objective') {
                document.getElementById('wiz-obj-proto').classList.toggle('bg-white/20', answer === 'proto');
                document.getElementById('wiz-obj-feature').classList.toggle('bg-white/20', answer === 'feature');
                document.getElementById('wiz-obj-async').classList.toggle('bg-white/20', answer === 'async');
            }

            evaluateWizard();
        }

        function evaluateWizard() {
            const { setup, interface: ui, objective } = wizardAnswers;
            if (!setup || !ui || !objective) return;

            let recommendedIds = [];
            let rationale = '';

            if (setup === 'no') {
                if (objective === 'proto' || ui === 'visual') {
                    recommendedIds = ['lovable', 'bolt', 'v0'];
                    rationale = 'Zero-setup in-browser web builders are best for instant prototyping without local runtime configuration.';
                } else if (objective === 'async') {
                    recommendedIds = ['devin', 'copilot-ws'];
                    rationale = 'Cloud-hosted async agents handle complete feature specs or PR generation directly in cloud runners.';
                } else {
                    recommendedIds = ['replit-agent', 'bolt'];
                    rationale = 'Full-stack in-browser environments give instant full-stack execution with zero local terminal needs.';
                }
            } else {
                if (ui === 'cli') {
                    recommendedIds = ['claude-code', 'aider'];
                    rationale = 'Terminal-native CLI agents provide high speed, git plumbing access, and raw shell execution.';
                } else if (objective === 'async') {
                    recommendedIds = ['antigravity', 'jules'];
                    rationale = 'Agent platforms featuring background subagents, worktrees, and visual testing loops maximize async productivity.';
                } else if (ui === 'ide') {
                    recommendedIds = ['antigravity', 'cursor', 'cline'];
                    rationale = 'AI-native IDEs and open VS Code extensions excel at multi-file codebase indexing and local file refactoring.';
                } else {
                    recommendedIds = ['cursor', 'windsurf'];
                    rationale = 'AI-native desktop environments offer real-time inline diffs, semantic context, and local terminal execution.';
                }
            }

            const recommendedTools = taxonomyData.filter(t => recommendedIds.includes(t.id));
            const resultBox = document.getElementById('wizard-result');
            resultBox.classList.remove('hidden');

            resultBox.innerHTML = `
                <div class="flex items-center space-x-2 text-indigo-700 font-bold text-sm">
                    <span>💡</span>
                    <span>Recommended Architectural Fit:</span>
                </div>
                <p class="text-xs text-slate-600">${rationale}</p>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 pt-2">
                    ${recommendedTools.map(t => `
                        <div onclick="openModal('${t.id}')" class="cursor-pointer bg-stone-50 border border-stone-200 hover:border-indigo-400 p-2.5 rounded-lg text-left transition">
                            <span class="text-[9px] font-bold uppercase text-indigo-600 bg-indigo-50 px-1.5 py-0.5 rounded">Layer ${t.layer}</span>
                            <div class="font-bold text-slate-900 text-xs mt-1">${t.name}</div>
                            <div class="text-[10px] text-slate-500 mt-0.5 truncate">${t.skillLevel} • ${t.runtime}</div>
                        </div>
                    `).join('')}
                </div>
            `;
        }
    </script>
