<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vibe Coding Architecture Taxonomy Explorer</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        /* Chosen Palette: Warm Neutral Harmonious - Slate & Indigo Accent */
        body {
            background-color: #fdfbf7;
            color: #1e293b;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        }

        /* Strict Chart Container Constraint */
        .chart-container {
            position: relative;
            width: 100%;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
            height: 320px;
            max-height: 380px;
        }

        @media (min-width: 768px) {
            .chart-container {
                height: 350px;
            }
        }

        /* Custom Scrollbar for sleek UI */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1efe9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        .tab-active {
            border-bottom: 2px solid #4f46e5;
            color: #4f46e5;
            font-weight: 600;
        }

        .tree-node-active {
            ring: 2px solid #6366f1;
            background-color: #eef2ff !important;
        }

        @keyframes pulse-dot {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(0.85); }
        }
        .live-pulse {
            animation: pulse-dot 1.8s infinite ease-in-out;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col">

    <!-- Chosen Palette: Warm Neutral Harmonious - Slate & Indigo Accent -->
    <!-- Application Structure Plan:
         1. Header & Executive Summary: Clean branding with fast-metric cards highlighting total layers, execution tiers, active user telemetry, and key paradigms.
         2. Section 1: Interactive Hierarchy Diagram (CSS/HTML Canvas flow diagram): Visual representation of User Intent -> Tier -> 5 Layers -> Tools. Clicking nodes filters downstream views.
         3. Section 2: Interactive Tool Directory & Matrix: Filterable, searchable cards across Layer, Execution Tier, and Technical Level with modal deep-dives.
         4. Section 3: Comparative Analytical Dashboard & Real-Time Statistics: 
            - Replaced previous scatter plot with a Global Active User Statistics Time-Series Chart tracking adoption across Layers 1 to 5.
            - Integrated dynamic Live Telemetry Refresh functionality with manual trigger & optional auto-polling toggle.
            - Maintained Layer Distribution Chart and Side-by-Side Tool Specification Matrix.
         5. Section 4: CS Engineering Trade-offs & Deep Dive: Interactive cards detailing Hallucination, Context Window vs. Cost (MCP/AST), and Determinism vs. Flexibility.
         6. Section 5: Interactive Tool Decision Wizard: A 3-question guided diagnostic suggesting the best tool based on user constraints.
         Why this structure: Combines structural taxonomy understanding with real-time quantitative monitoring and strategic trade-off analysis.
    -->
    <!-- Visualization & Content Choices:
         - Architectural Flow Diagram: Built with pure CSS Grid/Flexbox and Unicode connectors (NO SVG/Mermaid) with active state JS triggers.
         - Global User Number Statistics Chart: Chart.js Line Chart with dynamic multi-dataset tracking for Layer 1 through Layer 5, updated via JS live telemetry engine.
         - Layer Distribution Chart: Chart.js Doughnut chart showing ecosystem balance.
         - Comparison Matrix: Dynamic HTML table with JS filtering and active row highlight.
         - Decision Tree: JS state machine wizard with real-time matching algorithm.
    -->
    <!-- CONFIRMATION: NO SVG graphics used. NO Mermaid JS used. -->

    <!-- Navigation Header -->
    <header class="bg-white/80 backdrop-blur border-b border-stone-200 sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <span class="text-2xl" aria-hidden="true">⚡</span>
                <div>
                    <h1 class="text-lg font-bold text-slate-900 leading-tight">Vibe Coding Architecture Taxonomy</h1>
                    <p class="text-xs text-slate-500">Intent-Driven Software Engineering Hierarchy</p>
                </div>
            </div>
            <nav class="hidden md:flex space-x-6 text-sm font-medium text-slate-600">
                <button onclick="scrollToSection('taxonomy-map')" class="hover:text-indigo-600 transition">Taxonomy Map</button>
                <button onclick="scrollToSection('tool-directory')" class="hover:text-indigo-600 transition">Tool Directory</button>
                <button onclick="scrollToSection('analytics-section')" class="hover:text-indigo-600 transition">Global Telemetry</button>
                <button onclick="scrollToSection('tradeoffs-section')" class="hover:text-indigo-600 transition">CS Trade-offs</button>
                <button onclick="scrollToSection('wizard-section')" class="bg-indigo-50 text-indigo-600 px-3 py-1.5 rounded-lg border border-indigo-200 hover:bg-indigo-100 transition">Tool Finder</button>
            </nav>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-12">

        <!-- Executive Summary Section -->
        <section class="bg-stone-50 border border-stone-200 rounded-2xl p-6 sm:p-8">
            <div class="max-w-3xl">
                <span class="text-xs font-semibold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded-md border border-indigo-100">Architectural Overview</span>
                <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-3">From Syntax Writing to Intent-Driven Synthesis</h2>
                <p class="text-slate-600 mt-2 text-sm sm:text-base leading-relaxed">
                    Vibe coding transitions developers from imperative syntax authors to specification designers and system architects. Software tools are classified across two core axes: 
                    <strong class="text-slate-800">Execution Environment</strong> (Browser-hosted vs Local/Repo Worktree) and <strong class="text-slate-800">User Agency / Abstraction Level</strong> (Zero-setup sandboxes to headless background agents).
                </p>
            </div>

            <!-- Quick Metrics Grid -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6 pt-6 border-t border-stone-200">
                <div class="bg-white p-4 rounded-xl border border-stone-200 shadow-sm">
                    <span class="text-xs text-slate-500 font-medium">Architectural Layers</span>
                    <div class="text-2xl font-bold text-slate-900 mt-1">5 Tiers</div>
                    <span class="text-xs text-indigo-600 font-medium">Instant to Headless</span>
                </div>
                <div class="bg-white p-4 rounded-xl border border-stone-200 shadow-sm">
                    <span class="text-xs text-slate-500 font-medium">Indexed Tools</span>
                    <div class="text-2xl font-bold text-slate-900 mt-1">16 Tools</div>
                    <span class="text-xs text-emerald-600 font-medium">Across all runtimes</span>
                </div>
                <div class="bg-white p-4 rounded-xl border border-stone-200 shadow-sm">
                    <span class="text-xs text-slate-500 font-medium">Estimated Active Base</span>
                    <div class="text-2xl font-bold text-slate-900 mt-1" id="stat-total-users">14.8M+</div>
                    <span class="text-xs text-amber-600 font-medium flex items-center gap-1">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 live-pulse"></span>
                        Live Telemetry
                    </span>
                </div>
                <div class="bg-white p-4 rounded-xl border border-stone-200 shadow-sm">
                    <span class="text-xs text-slate-500 font-medium">Core Protocol</span>
                    <div class="text-2xl font-bold text-slate-900 mt-1">MCP & AST</div>
                    <span class="text-xs text-purple-600 font-medium">Standardized context</span>
                </div>
            </div>
        </section>

        <!-- SECTION 1: Interactive Hierarchy Diagram -->
        <section id="taxonomy-map" class="space-y-4">
            <div>
                <h3 class="text-xl font-bold text-slate-900">1. Interactive Architectural Taxonomy & Flowchart</h3>
                <p class="text-sm text-slate-600">Click on any tier or layer node to filter the tool catalog and inspect runtime capabilities.</p>
            </div>

            <div class="bg-white border border-stone-200 rounded-2xl p-6 shadow-sm overflow-x-auto">
                <div class="min-w-[700px] flex flex-col items-center space-y-6">
                    
                    <!-- Root Node -->
                    <div class="bg-slate-900 text-white px-6 py-2.5 rounded-xl font-semibold text-sm shadow-md flex items-center space-x-2">
                        <span>💬</span>
                        <span>User Intent & Natural Language Prompt</span>
                    </div>

                    <div class="text-slate-300 font-mono text-xs">│</div>

                    <!-- Execution Tiers (Level 2) -->
                    <div class="grid grid-cols-2 gap-12 w-full max-w-4xl">
                        <div onclick="selectTierFilter('Browser-Hosted Tier')" class="cursor-pointer bg-stone-50 hover:bg-stone-100 border-2 border-dashed border-amber-300 p-4 rounded-xl text-center transition">
                            <span class="text-xs font-bold text-amber-700 uppercase tracking-wider">Tier A</span>
                            <h4 class="font-bold text-slate-800 text-base">BROWSER-HOSTED TIER</h4>
                            <p class="text-xs text-slate-500 mt-1">Ephemeral Sandboxes & Cloud Containers</p>
                        </div>

                        <div onclick="selectTierFilter('Local & Repo Tier')" class="cursor-pointer bg-stone-50 hover:bg-stone-100 border-2 border-dashed border-indigo-300 p-4 rounded-xl text-center transition">
                            <span class="text-xs font-bold text-indigo-700 uppercase tracking-wider">Tier B</span>
                            <h4 class="font-bold text-slate-800 text-base">LOCAL & REPO TIER</h4>
                            <p class="text-xs text-slate-500 mt-1">Worktree, Native FS & Language Servers</p>
                        </div>
                    </div>

                    <div class="text-slate-300 font-mono text-xs">┌──────────────────────────────────────────┴──────────────────────────────────────────┐</div>

                    <!-- 5 Layers (Level 3) -->
                    <div class="grid grid-cols-5 gap-3 w-full">
                        
                        <!-- Layer 1 -->
                        <div id="layer-card-1" onclick="selectLayerFilter(1)" class="cursor-pointer bg-amber-50/60 hover:bg-amber-100/80 border border-amber-200 p-3 rounded-xl transition flex flex-col justify-between text-left">
                            <div>
                                <span class="text-[10px] font-bold text-amber-800 uppercase bg-amber-200/60 px-1.5 py-0.5 rounded">Layer 1</span>
                                <h5 class="font-bold text-slate-900 text-xs mt-1.5">Instant Builders</h5>
                                <p class="text-[11px] text-slate-600 mt-1 leading-tight">Zero-setup in-browser full stack</p>
                            </div>
                            <div class="mt-3 pt-2 border-t border-amber-200/60 text-[10px] font-semibold text-amber-900">
                                Lovable, Bolt.new, v0, Replit
                            </div>
                        </div>

                        <!-- Layer 5 (Grouped under cloud/async) -->
                        <div id="layer-card-5" onclick="selectLayerFilter(5)" class="cursor-pointer bg-purple-50/60 hover:bg-purple-100/80 border border-purple-200 p-3 rounded-xl transition flex flex-col justify-between text-left">
                            <div>
                                <span class="text-[10px] font-bold text-purple-800 uppercase bg-purple-200/60 px-1.5 py-0.5 rounded">Layer 5</span>
                                <h5 class="font-bold text-slate-900 text-xs mt-1.5">Headless PR Agents</h5>
                                <p class="text-[11px] text-slate-600 mt-1 leading-tight">Async issue-to-PR pipelines</p>
                            </div>
                            <div class="mt-3 pt-2 border-t border-purple-200/60 text-[10px] font-semibold text-purple-900">
                                Devin, Jules, Copilot WS
                            </div>
                        </div>

                        <!-- Layer 2 -->
                        <div id="layer-card-2" onclick="selectLayerFilter(2)" class="cursor-pointer bg-indigo-50/60 hover:bg-indigo-100/80 border border-indigo-200 p-3 rounded-xl transition flex flex-col justify-between text-left">
                            <div>
                                <span class="text-[10px] font-bold text-indigo-800 uppercase bg-indigo-200/60 px-1.5 py-0.5 rounded">Layer 2</span>
                                <h5 class="font-bold text-slate-900 text-xs mt-1.5">AI-Native IDEs</h5>
                                <p class="text-[11px] text-slate-600 mt-1 leading-tight">Deep repo indexing & multi-file agents</p>
                            </div>
                            <div class="mt-3 pt-2 border-t border-indigo-200/60 text-[10px] font-semibold text-indigo-900">
                                Antigravity, Cursor, Windsurf
                            </div>
                        </div>

                        <!-- Layer 3 -->
                        <div id="layer-card-3" onclick="selectLayerFilter(3)" class="cursor-pointer bg-emerald-50/60 hover:bg-emerald-100/80 border border-emerald-200 p-3 rounded-xl transition flex flex-col justify-between text-left">
                            <div>
                                <span class="text-[10px] font-bold text-emerald-800 uppercase bg-emerald-200/60 px-1.5 py-0.5 rounded">Layer 3</span>
                                <h5 class="font-bold text-slate-900 text-xs mt-1.5">CLI & Shell Agents</h5>
                                <p class="text-[11px] text-slate-600 mt-1 leading-tight">Terminal native, AST & git plumbing</p>
                            </div>
                            <div class="mt-3 pt-2 border-t border-emerald-200/60 text-[10px] font-semibold text-emerald-900">
                                Claude Code, Aider, OpenCode
                            </div>
                        </div>

                        <!-- Layer 4 -->
                        <div id="layer-card-4" onclick="selectLayerFilter(4)" class="cursor-pointer bg-cyan-50/60 hover:bg-cyan-100/80 border border-cyan-200 p-3 rounded-xl transition flex flex-col justify-between text-left">
                            <div>
                                <span class="text-[10px] font-bold text-cyan-800 uppercase bg-cyan-200/60 px-1.5 py-0.5 rounded">Layer 4</span>
                                <h5 class="font-bold text-slate-900 text-xs mt-1.5">Open Extensions</h5>
                                <p class="text-[11px] text-slate-600 mt-1 leading-tight">BYOK, modular tool & MCP integration</p>
                            </div>
                            <div class="mt-3 pt-2 border-t border-cyan-200/60 text-[10px] font-semibold text-cyan-900">
                                Cline, Roo Code, Continue
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 2: Filterable Tool Directory -->
        <section id="tool-directory" class="space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <h3 class="text-xl font-bold text-slate-900">2. Tool Directory & Runtime Catalog</h3>
                    <p class="text-sm text-slate-600">Filter software synthesis platforms by layer, runtime tier, or technical entry barrier.</p>
                </div>
                <button onclick="resetFilters()" class="self-start sm:self-auto text-xs bg-stone-200 hover:bg-stone-300 text-slate-700 px-3 py-1.5 rounded-lg transition font-medium">
                    🔄 Reset All Filters
                </button>
            </div>

            <!-- Filter Controls Panel -->
            <div class="bg-stone-100 border border-stone-200 rounded-xl p-4 flex flex-wrap gap-3 items-center">
                <div class="w-full sm:w-auto flex-1 min-w-[200px]">
                    <input type="text" id="search-input" oninput="applyFilters()" placeholder="Search tools, models, capabilities..." class="w-full bg-white border border-stone-300 text-slate-800 text-xs rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>

                <select id="layer-filter" onchange="applyFilters()" class="bg-white border border-stone-300 text-slate-800 text-xs rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <option value="ALL">All Layers (1 to 5)</option>
                    <option value="1">Layer 1: Instant Web Builders</option>
                    <option value="2">Layer 2: AI-Native Desktop IDEs</option>
                    <option value="3">Layer 3: CLI Shell Agents</option>
                    <option value="4">Layer 4: Open IDE Extensions</option>
                    <option value="5">Layer 5: Headless PR Agents</option>
                </select>

                <select id="tier-filter" onchange="applyFilters()" class="bg-white border border-stone-300 text-slate-800 text-xs rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <option value="ALL">All Runtimes</option>
                    <option value="Browser-Hosted Tier">Browser-Hosted Tier</option>
                    <option value="Local & Repo Tier">Local & Repo Tier</option>
                </select>

                <select id="skill-filter" onchange="applyFilters()" class="bg-white border border-stone-300 text-slate-800 text-xs rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <option value="ALL">All Technical Levels</option>
                    <option value="Beginner">Beginner (Zero setup)</option>
                    <option value="Intermediate">Intermediate (IDE knowledge)</option>
                    <option value="Advanced">Advanced (CLI/System Eng)</option>
                </select>
            </div>

            <!-- Tool Cards Grid -->
            <div id="tools-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                <!-- Dynamically Populated by JS -->
            </div>
        </section>

        <!-- SECTION 3: Comparative Analytical Dashboard & Charts -->
        <section id="analytics-section" class="space-y-6">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <h3 class="text-xl font-bold text-slate-900">3. Ecosystem Telemetry & Global Active User Statistics</h3>
                    <p class="text-sm text-slate-600">Dynamic tracking of active developer user numbers across taxonomy layers with real-time refresh capability.</p>
                </div>
                
                <!-- Telemetry Control Toolbar -->
                <div class="flex items-center space-x-3 bg-white p-2 rounded-xl border border-stone-200 shadow-sm self-start md:self-auto">
                    <div class="flex items-center space-x-1.5 px-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 live-pulse"></span>
                        <span class="text-xs font-semibold text-slate-700" id="telemetry-status">Telemetry Active</span>
                    </div>
                    <span class="text-stone-300">|</span>
                    <button onclick="refreshUserTelemetry()" id="refresh-btn" class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold px-3 py-1.5 rounded-lg transition flex items-center space-x-1">
                        <span>🔄</span>
                        <span>Refresh Telemetry</span>
                    </button>
                    <label class="flex items-center space-x-1.5 text-xs text-slate-600 cursor-pointer pl-1">
                        <input type="checkbox" id="auto-refresh-toggle" onchange="toggleAutoRefresh()" class="rounded text-indigo-600 focus:ring-indigo-500 h-3.5 w-3.5">
                        <span>Auto Poll (5s)</span>
                    </label>
                </div>
            </div>

            <!-- Visual Charts Row -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- Chart 1: Global Active User Statistics across Layers (REPLACED CHART) -->
                <div class="bg-white border border-stone-200 rounded-2xl p-5 shadow-sm space-y-2">
                    <div class="flex items-center justify-between">
                        <div>
                            <h4 class="font-bold text-slate-800 text-sm">Global Active Users Across Taxonomy Layers</h4>
                            <p class="text-xs text-slate-500">Monthly active developer telemetry (in thousands) tracked over time.</p>
                        </div>
                        <span class="text-[10px] font-mono bg-stone-100 text-slate-600 px-2 py-1 rounded border border-stone-200" id="last-update-tag">Updated: Just Now</span>
                    </div>
                    <div class="chart-container">
                        <canvas id="userStatsChart"></canvas>
                    </div>
                </div>

                <!-- Chart 2: Category Tool Distribution -->
                <div class="bg-white border border-stone-200 rounded-2xl p-5 shadow-sm space-y-2">
                    <div>
                        <h4 class="font-bold text-slate-800 text-sm">Tool Distribution Across Layer Runtimes</h4>
                        <p class="text-xs text-slate-500">Proportion of software synthesis tools indexed per layer.</p>
                    </div>
                    <div class="chart-container">
                        <canvas id="layerDonutChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Dynamic Side-by-Side Comparison Selector & Matrix -->
            <div class="bg-white border border-stone-200 rounded-2xl p-6 shadow-sm space-y-4">
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                    <div>
                        <h4 class="font-bold text-slate-800 text-base">Side-by-Side Tool Specification Matrix</h4>
                        <p class="text-xs text-slate-500">Select up to 3 tools to compare architectural details directly.</p>
                    </div>
                    <div class="flex flex-wrap gap-2" id="comparison-selectors">
                        <!-- Selectors generated via JS -->
                    </div>
                </div>

                <div class="overflow-x-auto border border-stone-200 rounded-xl">
                    <table class="w-full text-left text-xs border-collapse">
                        <thead>
                            <tr class="bg-stone-100 border-b border-stone-200 text-slate-700">
                                <th class="p-3 font-semibold w-1/4">Specification Factor</th>
                                <th class="p-3 font-semibold text-indigo-700 w-1/4" id="matrix-head-1">Tool A</th>
                                <th class="p-3 font-semibold text-purple-700 w-1/4" id="matrix-head-2">Tool B</th>
                                <th class="p-3 font-semibold text-emerald-700 w-1/4" id="matrix-head-3">Tool C</th>
                            </tr>
                        </thead>
                        <tbody id="comparison-matrix-body" class="divide-y divide-stone-200 text-slate-700 bg-white">
                            <!-- Populated via JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- SECTION 4: CS Engineering Trade-offs -->
        <section id="tradeoffs-section" class="space-y-4">
            <div>
                <h3 class="text-xl font-bold text-slate-900">4. Computer Science Trade-offs & Deep Dive</h3>
                <p class="text-sm text-slate-600">Fundamental technical tensions inherent in intent-based AI software engineering.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Tradeoff Card 1 -->
                <div class="bg-white border border-stone-200 rounded-2xl p-5 shadow-sm space-y-3">
                    <div class="w-8 h-8 rounded-lg bg-amber-100 text-amber-800 flex items-center justify-center font-bold text-sm">1</div>
                    <h4 class="font-bold text-slate-900 text-base">Hallucination vs. Architectural Drift</h4>
                    <p class="text-xs text-slate-600 leading-relaxed">
                        As prompt chains grow, agents risk circular dependencies, duplicated utility functions, and deprecated library methods.
                    </p>
                    <div class="bg-stone-50 p-3 rounded-lg border border-stone-200 text-[11px] text-slate-600">
                        <strong class="text-slate-800 block mb-1">Mitigation Strategy:</strong>
                        Strict test suites (`pytest`, `vitest`), clean git worktree rollbacks, and automated AST validation.
                    </div>
                </div>

                <!-- Tradeoff Card 2 -->
                <div class="bg-white border border-stone-200 rounded-2xl p-5 shadow-sm space-y-3">
                    <div class="w-8 h-8 rounded-lg bg-indigo-100 text-indigo-800 flex items-center justify-center font-bold text-sm">2</div>
                    <h4 class="font-bold text-slate-900 text-base">Context Window vs. Token Cost</h4>
                    <p class="text-xs text-slate-600 leading-relaxed">
                        Feeding entire repositories to LLMs exceeds context limits and skyrockets API costs without sparse indexing.
                    </p>
                    <div class="bg-stone-50 p-3 rounded-lg border border-stone-200 text-[11px] text-slate-600">
                        <strong class="text-slate-800 block mb-1">Mitigation Strategy:</strong>
                        Model Context Protocol (MCP) servers, RAG vector embeddings, and AST-pruned dependency trees.
                    </div>
                </div>

                <!-- Tradeoff Card 3 -->
                <div class="bg-white border border-stone-200 rounded-2xl p-5 shadow-sm space-y-3">
                    <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-800 flex items-center justify-center font-bold text-sm">3</div>
                    <h4 class="font-bold text-slate-900 text-base">Determinism vs. Stack Flexibility</h4>
                    <p class="text-xs text-slate-600 leading-relaxed">
                        In-browser builders guarantee compilation through fixed frameworks (React+Tailwind+Supabase) at the cost of customization.
                    </p>
                    <div class="bg-stone-50 p-3 rounded-lg border border-stone-200 text-[11px] text-slate-600">
                        <strong class="text-slate-800 block mb-1">Mitigation Strategy:</strong>
                        Use Layer 1 for rapid prototypes; export to Layer 2 IDEs (Cursor/Antigravity) for custom production stacks.
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 5: Tool Decision Wizard -->
